# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ai_learning_rec

# JWT
JWT_SECRET=super_secret_dev_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Free AI Provider Configuration ('gemini' | 'groq' | 'ollama' | 'mock')
AI_PROVIDER=mock

# Google Gemini Free Tier (get key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq Free API (get key from https://console.groq.com/)
GROQ_API_KEY=

# Ollama Local (run: ollama serve && ollama pull llama3.2:3b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Client
VITE_API_URL=http://localhost:5000/api